# src/app/refinance_screen.nova - the refinance screen's calculation, behind
# one call for the Python host. Same contract as amortization_screen.nova.
#
# Rates are typed as annual percentages and converted to monthly
# (annual / 12, exact). Closing costs are all-in and paid up front, not
# financed (src/finance/refinance.nova). The CSV/table is one row per
# scenario - keep the current loan, or refinance - not one row per month.

import "./parse_helpers.nova" as inputs
import "../finance/refinance.nova" as refi

let CURRENCY = inputs.CURRENCY
let SCALE = inputs.SCALE
let MAX_MONTHS = 1200

let ASSUMPTIONS = [
    "Closing costs are all-in (points, appraisal, title...), paid up front, and not added to the new loan.",
    "The new loan's principal is the current principal; its payment is the TVM closed form at the new rate and term.",
    "Monthly rates are annual / 12. Both loans use their actual payments, including the final adjustment.",
    "Break-even is the first month the cumulative savings reach the closing costs.",
    "The headline is lifetime: current total paid - (new total paid + closing costs).",
    "'Over remaining term' only counts months while both loans run, so it ignores the longer loan's extra months and can disagree with lifetime, even in sign."
]

# The headline as words around an amount, so a loss can never read as a
# saving: {before, amount, after} - the host prints before + amount + after.
def lifetime_phrase(minor) {
    if minor >= 0 {
        return {before: "saves ", amount: minor, after: " over both loans' lives"}
    }
    return {before: "costs ", amount: 0 - minor, after: " MORE than keeping the current loan"}
}

export def calculate(principal_text, current_rate_text, remaining_text, payment_text, new_rate_text, new_term_text, closing_text) {
    let principal = inputs.amount(principal_text, "current principal")
    let current_rate = inputs.monthly_rate(current_rate_text, "current annual rate", false)
    let remaining = inputs.count(remaining_text, "months remaining", 1, MAX_MONTHS)
    let payment = inputs.amount(payment_text, "current payment")
    let new_rate = inputs.monthly_rate(new_rate_text, "new annual rate", false)
    let new_term = inputs.count(new_term_text, "new term (months)", 1, MAX_MONTHS)
    let closing = inputs.amount(closing_text, "closing costs")
    let result = refi.compare(principal, current_rate, remaining, payment, new_rate, new_term, closing)
    let break_even = "never"
    if result.breaks_even {
        break_even = "month " + str(result.break_even_month)
    }
    return {
        currency: CURRENCY,
        scale: SCALE,
        new_payment: result.new_payment.minor,
        monthly_savings: result.monthly_savings.minor,
        break_even: break_even,
        breaks_even: result.breaks_even,
        break_even_month: result.break_even_month,
        lifetime_savings: result.lifetime_savings.minor,
        lifetime_result: lifetime_phrase(result.lifetime_savings.minor),
        savings_over_remaining_term: result.savings_over_remaining_term.minor,
        columns: ["scenario", "monthly_payment", "total_paid", "total_interest", "payoff_month", "closing_costs"],
        column_kinds: ["text", "money", "money", "money", "count", "money"],
        rows: [
            ["Keep current loan", payment.minor, result.current_total_paid.minor, result.current_total_interest.minor, result.payoff_period_current, 0],
            ["Refinance", result.new_payment.minor, result.new_total_paid.minor, result.new_total_interest.minor, result.payoff_period_new, closing.minor]
        ],
        assumptions: ASSUMPTIONS
    }
}
