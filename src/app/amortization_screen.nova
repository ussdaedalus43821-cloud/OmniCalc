# src/app/amortization_screen.nova - everything the amortization screen
# computes, behind one call for the Python host (src/host/app.py).
#
# calculate() takes the four input boxes AS TYPED (strings) and returns only
# integers, scales and strings. The host's whole job is to format
# integer + scale as text and draw it (CLAUDE.md "Bridge contract").
#
# Assumptions, also returned for the screen to show:
#   monthly payments at the end of each month; the monthly rate is the annual
#   rate / 12 (rates.per_period); interest rounds half-up to the cent each
#   month; the final payment is adjusted to clear the balance; the
#   "IRR-implied annual rate" is the schedule's monthly IRR x 12.

import "../core/parse.nova" as parse
import "../core/money.nova" as money
import "../core/rates.nova" as rates
import "../finance/tvm.nova" as tvm
import "../finance/amortization.nova" as am
import "../finance/cashflow.nova" as cf

let CURRENCY = "USD"
let SCALE = 2
# The annual rate is typed in percent with up to 4 decimals, which is
# exactly micro-units of a fraction: "6.5" -> 65000 (1e-6 = 0.0001%).
let RATE_INPUT_SCALE = 4
# The IRR-implied rate is shown in percent with 4 decimals.
let RATE_DISPLAY_SCALE = 4
let MONTHS_PER_YEAR = 12

let ASSUMPTIONS = [
    "Payments are monthly, at the end of each month.",
    "Monthly rate = annual rate / 12, kept exact (never pre-rounded).",
    "Payment = the TVM closed form, rounded half-up to the cent.",
    "Interest each month = balance x monthly rate, rounded half-up to the cent.",
    "The final payment is adjusted to clear the balance; the adjustment column shows by how much.",
    "IRR-implied annual rate = the schedule's monthly IRR x 12, from the actual rounded payments."
]

def amount(text, what) {
    return money.make(parse.decimal(text, SCALE, what), SCALE, CURRENCY)
}

export def calculate(principal_text, rate_text, months_text, extra_text) {
    let principal = amount(principal_text, "principal")
    let annual_micro = parse.decimal(rate_text, RATE_INPUT_SCALE, "annual rate")
    if annual_micro < 0 {
        throw("parse: annual rate must not be negative")
    }
    let months = parse.whole(months_text, "number of months")
    let extra_typed = extra_text
    if trim(extra_text) == "" {
        extra_typed = "0"
    }
    let extra = amount(extra_typed, "extra principal per month")

    let monthly = rates.per_period(rates.annual(annual_micro), MONTHS_PER_YEAR)
    let payment = money.negate(tvm.pmt(principal, money.make(0, SCALE, CURRENCY), months, monthly))
    let schedule = am.schedule_with_extra(principal, monthly, months, payment, extra, [])
    let rate = cf.schedule_irr(schedule)
    # percent with RATE_DISPLAY_SCALE decimals: rate.num / (rate.den * MICRO) * 12 * 100 * 10^scale
    let implied = money.round_half_up(rate.num * MONTHS_PER_YEAR * 100 * pow(10, RATE_DISPLAY_SCALE), rate.den * rates.MICRO)

    let rows = []
    for row in schedule.rows {
        append(rows, [row.period, row.payment.minor, row.interest.minor, row.principal.minor, row.balance.minor, row.extra.minor, row.adjustment.minor])
    }
    return {
        currency: CURRENCY,
        scale: SCALE,
        payment: payment.minor,
        total_paid: schedule.totals.total_paid.minor,
        total_interest: schedule.totals.total_interest.minor,
        payoff_period: schedule.totals.payoff_period,
        implied_rate: {value: implied, scale: RATE_DISPLAY_SCALE},
        columns: ["period", "payment", "interest", "principal", "balance", "extra", "adjustment"],
        rows: rows,
        assumptions: ASSUMPTIONS
    }
}
