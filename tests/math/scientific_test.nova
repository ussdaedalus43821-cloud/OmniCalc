# module: scientific
# expect: 112
#
# Every case in tests/math/vectors/scientific.json (generated by
# tests/math/gen_math_vectors.py, where each expression is written twice -
# as the text parsed here and as an independent Python expression), plus a
# few direct checks of the helpers. Exact cases must match num/den, display
# and exact_text exactly; float cases must match display exactly and the
# value within a relative 1e-14 (our exp/atan are not Python's, so the last
# bit may differ); error cases must throw a message containing the fragment.

import "../../tools/check.nova" as t
import "../../src/math/scientific.nova" as sci

let vectors = json.loads(read("tests/math/vectors/scientific.json"))

def run_case(c) {
    let label = c.text
    if len(label) > 40 {
        label = label[0:40] + "..."
    }
    label = label + " [" + c.angle + "]"
    if "error" in c {
        def attempt() { sci.evaluate(c.text, {angle: c.angle}) }
        t.check_throws(label, attempt, c.error)
        return true
    }
    # An unexpected error is this case's failure, not the whole file's: the
    # other cases still run, so a regression shows every convention it broke.
    let outcome = {got: {}, error: ""}
    try {
        outcome["got"] = sci.evaluate(c.text, {angle: c.angle})
    } catch problem {
        outcome["error"] = str(problem)
    }
    if outcome.error != "" {
        t.check(label, "threw: " + outcome.error, "a result of kind " + c.kind)
        return false
    }
    let got = outcome.got
    if c.kind == "exact" {
        t.check(label, [got.value.kind, got.value.num, got.value.den, got.display, got.exact_text], ["exact", c.num, c.den, c.display, c.exact_text])
        return true
    }
    let scale = abs(c.value)
    if scale < 1 {
        scale = 1
    }
    let close = got.value.kind == "float" and abs(got.value.value - c.value) <= 0.00000000000001 * scale
    t.check(label, [got.value.kind, close, got.display], ["float", true, c.display])
    return true
}

for c in vectors.cases {
    run_case(c)
}

# ---- helpers, directly
t.check("isqrt of a 40-digit perfect square", sci.isqrt(pow(12345678901234567890, 2)), 12345678901234567890)
t.check("isqrt floors", sci.isqrt(99), 9)
t.check("exact() reduces and normalizes the sign", sci.exact(6, -8), {kind: "exact", num: -3, den: 4})
t.check("display of a float that rounds up to 10", sci.display({kind: "float", value: 9.9999999999999}, 12), "10")
t.check("display of the smallest subnormal float", sci.display({kind: "float", value: pow(2.0, -1074)}, 12), "4.94065645841e-324")
def token_at(token) {
    return token.at
}
t.check("tokens carry positions", map(token_at, sci.tokenize("12 + x")), [0, 3, 5, 6])
def bad_angle() { sci.evaluate("1", {angle: "grad"}) }
t.check_throws("angle must be rad or deg", bad_angle, "angle must be rad or deg")

t.finish()
