# module: investments_screen
# expect: 16
#
# A 20-position portfolio (24 lots) from tests/app/vectors/portfolio_20.json,
# generated by tests/app/gen_portfolio_vectors.py: the input rows as typed and
# every expected figure. tools/run_tests.py runs from the repository root.

import "../../tools/check.nova" as t
import "../../src/app/investments_screen.nova" as screen

let vector = json.loads(read("tests/app/vectors/portfolio_20.json"))
let expected = vector.expected
let result = screen.calculate(vector.rows, vector.as_of)

def flatten(row) {
    return [row[0], row[1].value, row[2], row[3], row[4], row[5], row[6], row[7].value, row[8].value]
}
let diff = {first: "none"}
for i = 0 to len(expected.positions) - 1 {
    let got = flatten(result.rows[i])
    if got != expected.positions[i] and diff.first == "none" {
        diff["first"] = "position " + str(i + 1) + ": expected " + str(expected.positions[i]) + ", got " + str(got)
    }
}
t.check("20 positions", [result.positions, len(result.rows)], [20, 20])
t.check("every position row matches the reference", diff.first, "none")
t.check("total cost basis", result.total_cost, expected.total_cost)
t.check("total value", result.total_value, expected.total_value)
t.check("total gain", result.total_gain, expected.total_gain)
t.check("total gain %", result.total_gain_pct.value, expected.total_gain_pct)
t.check("portfolio return (XIRR over all 24 lots)", result.portfolio_return.value, expected.portfolio_return_pct)
let allocation = result.extra_tables[0].rows
let alloc_flat = []
let bp_total = {sum: 0}
for row in allocation {
    append(alloc_flat, [row[0], row[1], row[2].value])
    bp_total["sum"] = bp_total.sum + row[2].value
}
t.check("allocation matches the reference (sorted, largest remainder)", alloc_flat, expected.allocation)
t.check("allocation sums to exactly 100.00%", bp_total.sum, 10000)

let small = screen.calculate([["vti", "10", "150", "195.17", "2023-01-15"], ["VTI", "5", "180", "195.17", "2023-08-01"], ["CASH", "1000", "1", "1", ""], ["", "", "", "", ""]], "2025-10-31")
t.check("lowercase symbols merge into one position", [small.positions, small.rows[0][0]], [2, "VTI"])
t.check("an undated lot hides the portfolio return", small.portfolio_return, {})
t.check("an undated position has no annualized figure", small.rows[1][8], {})
def conflicting_price() { screen.calculate([["VTI", "1", "100", "200", ""], ["VTI", "1", "100", "201", ""]], "2025-10-31") }
t.check_throws("two current prices for one symbol", conflicting_price, "VTI has two different current prices")
def future_purchase() { screen.calculate([["VTI", "1", "100", "200", "2026-01-01"]], "2025-10-31") }
t.check_throws("a purchase after the as-of date", future_purchase, "purchase date is after the as-of date")
def bad_date() { screen.calculate([["VTI", "1", "100", "200", "2025-02-30"]], "2025-10-31") }
t.check_throws("an impossible date", bad_date, "day 30 is not in 2025-2")
def zero_shares() { screen.calculate([["VTI", "0", "100", "200", ""]], "2025-10-31") }
t.check_throws("zero shares", zero_shares, "VTI shares must be positive")

t.finish()
